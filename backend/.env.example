# =============================================================================
# InterviewReady backend — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- application ---
APP_ENV=development                 # development | staging | production | test
APP_NAME=InterviewReady API
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- database (Supabase PostgreSQL) ---
# Runtime connection. Use the Supabase *connection pooler* for the app.
# Supports postgres:// and postgresql:// — the driver suffix is added automatically.
#
# Get the exact string from: Supabase dashboard > Connect > "Session pooler".
# The username is `postgres.<project-ref>`, NOT plain `postgres`. That dot is required.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migration connection, also via the pooler (port 5432 = session mode, which supports DDL).
# Falls back to DATABASE_URL when empty.
#
# WHY NOT THE DIRECT HOST: `db.<project-ref>.supabase.co` publishes ONLY an AAAA record
# (verified: no A record). IPv4-only hosts — Render's default networking among them — cannot
# resolve it, so a deploy configured with the direct host fails to connect rather than
# degrading. The pooler is dual-stack and is the supported path for hosted deployments.
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Dedicated database for the pytest suite. Leave empty to skip all DB-backed tests.
TEST_DATABASE_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=30000

# --- Supabase Auth ---
# Only the project URL is needed: the public JWKS is read from
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key. Optional — only used for diagnostics, never for auth decisions.
SUPABASE_PUBLISHABLE_KEY=
# Override only if you proxy the JWKS endpoint. Defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Expected audience claim in Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated
# How long to cache the fetched JWKS (seconds). Keep <= 600 to allow key rotation.
SUPABASE_JWKS_CACHE_SECONDS=600

# --- CORS ---
# Comma separated. Never use "*" together with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI tutor ---
AI_PROVIDER=gemini                  # gemini | groq | stub
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_HISTORY_MESSAGES=12
AI_RATE_LIMIT_PER_HOUR=60

# --- business rules / tunables ---
DEFAULT_TIMEZONE=UTC
DAILY_DSA_COUNT_DEFAULT=3
DAILY_DSA_COUNT_MAX=15
STREAK_MIN_MINUTES=1
STREAK_MIN_ACTIVITIES=1
# Confidence -> spaced repetition interval ladder, in days. JSON string.
# Index in the inner list is the number of completed revisions so far.
REVISION_INTERVALS_JSON={"0": [1], "1": [1, 3], "2": [2, 5, 12], "3": [3, 7, 16, 35], "4": [5, 14, 35, 75, 150], "5": [7, 21, 60, 120, 240, 365]}

# --- frontend ---
FRONTEND_URL=http://localhost:5173
