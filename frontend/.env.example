# ---------------------------------------------------------------------------
# InterviewReady frontend configuration
# Copy to `.env.local` and adjust. Every value is optional: the app falls back
# to mock mode so it always boots.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. Leave empty to use the Vite dev proxy (`/api`).
VITE_API_BASE_URL=/api/v1

# `true`  -> the app renders from the in-memory mock data layer (no backend).
# `false` -> the app calls the real FastAPI endpoints and requires authentication.
VITE_USE_MOCKS=true

# Supabase project (only needed when VITE_USE_MOCKS=false and you sign in for real).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Override the dev-proxy target when the backend is not on localhost:8000.
VITE_API_PROXY_TARGET=http://localhost:8000
